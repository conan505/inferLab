# Copy to .env before running: cp .env.example .env

# Secret used to sign JWTs. Required, minimum 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# Access token lifetime, in minutes.
JWT_EXPIRES_MINUTES=15
JWT_ISSUER=task-api

# SQLAlchemy URL. Any SQL backend works; SQLite is the zero-setup default.
DATABASE_URL=sqlite:///./data/task-api.db

ENVIRONMENT=development
PORT=8000

# bcrypt work factor. Lower it only in tests.
BCRYPT_ROUNDS=12

# Brute-force budget for the unauthenticated /auth routes, per client IP.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Enable only when genuinely behind a trusted proxy, otherwise clients can
# spoof X-Forwarded-For and evade the rate limiter.
TRUST_PROXY=false
