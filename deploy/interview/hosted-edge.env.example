# Install this file with mode 0600 outside the repository, replace every
# `replace-...` value, then load it into a trusted shell before running
# `./deploy/interview/start.sh --hosted-edge` from the repository root.
# These placeholders are deliberately unusable and are not credentials.

INFERLAB_PUBLIC_API_KEYS=replace-with-a-long-random-public-demo-key
INFERLAB_OPERATOR_API_KEY=replace-with-a-distinct-long-random-operator-key
INFERLAB_OPERATOR_BIND=0.0.0.0:8081

# Supply a matching route-signing private seed and trusted public key from a
# secret store. The trusted-key value has the form key-id=base64-public-key.
INFERLAB_CONTROL_SIGNING_KEY_ID=replace-route-key-id
INFERLAB_CONTROL_SIGNING_PRIVATE_KEY_B64=replace-with-base64-ed25519-private-seed
INFERLAB_CONTROL_TRUSTED_KEYS=replace-route-key-id=replace-with-base64-ed25519-public-key

# Public-edge limits. The tiny teaching model itself has a 32-token context,
# so this profile intentionally asks for a stricter output ceiling than the
# gateway-wide default.
INFERLAB_PUBLIC_MAX_MESSAGES=32
INFERLAB_PUBLIC_MAX_PROMPT_BYTES=16384
INFERLAB_PUBLIC_MAX_OUTPUT_TOKENS=32
INFERLAB_PUBLIC_RATE_REQUESTS_PER_MINUTE=60
INFERLAB_PUBLIC_RATE_BURST=4

# Optional local image tag. The start script still builds the current checkout
# with this tag unless INFERLAB_SKIP_BUILD=1 selects an already-built image.
# INFERLAB_IMAGE_TAG=v0.28
# INFERLAB_SKIP_BUILD=1
